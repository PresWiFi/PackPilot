<Window x:Class="PackPilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PackPilot" Icon="PackPilot.ico" Width="1180" Height="820" MinWidth="940" MinHeight="620"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <Grid Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Open project" Style="{StaticResource Link}" Click="OnOpenProject" Margin="0,0,16,0"/>
        <Button Content="New" Style="{StaticResource Link}" Click="OnNew"/>
      </StackPanel>
      <TextBlock Text="PackPilot" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
    </DockPanel>

    <!-- Empty state: one big drop target -->
    <Border x:Name="DropZone" Grid.Row="1" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource Line}" Background="{StaticResource Panel}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
        <Image Source="PackPilot.png" Width="72" Height="72" Margin="0,0,0,16"/>
        <TextBlock Text="Drop an installer here" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text=".exe, .msi or .ps1" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,18"/>
        <Button Content="Browse..." Style="{StaticResource Primary}" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Padding="28,10" Click="OnBrowse"/>
        <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,18,0,0"
                   Text="PackPilot works out the silent switches, builds the .intunewin, tests it in Windows Sandbox and can upload it to Intune."/>
      </StackPanel>
    </Border>

    <!-- Workspace: app header, settings tabs + steps, activity log -->
    <Grid x:Name="Workspace" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="180"/>
      </Grid.RowDefinitions>

      <!-- App header -->
      <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,12">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Choose another file" Style="{StaticResource Link}" Click="OnBrowse" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock x:Name="AppTitle" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <WrapPanel Margin="0,6,0,0">
              <Border Style="{StaticResource Chip}" Background="#E0E7FF"><TextBlock x:Name="EngineText" FontSize="12" Foreground="#3730A3"/></Border>
              <Border x:Name="ConfidenceChip" Style="{StaticResource Chip}"><TextBlock x:Name="ConfidenceText" FontSize="12"/></Border>
              <Border x:Name="SignatureChip" Style="{StaticResource Chip}"><TextBlock x:Name="SignatureChipText" FontSize="12"/></Border>
              <TextBlock x:Name="DropSub" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
            </WrapPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Settings, one tab at a time -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,6,18,14">
          <TabControl x:Name="Form" IsEnabled="False" Style="{StaticResource Tabs}">

            <TabItem Header="App">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Name" Style="{StaticResource Label}"/>
                      <TextBox x:Name="NameBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Version" Style="{StaticResource Label}"/>
                      <TextBox x:Name="VersionBox"/>
                    </StackPanel>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Publisher" Style="{StaticResource Label}"/>
                      <TextBox x:Name="PublisherBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Description" Style="{StaticResource Label}"/>
                      <TextBox x:Name="DescriptionBox"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="InstallArgsLabel" Text="Silent install arguments" Style="{StaticResource Label}" Margin="0,16,0,3"/>
                  <TextBox x:Name="InstallArgsBox" Style="{StaticResource Mono}"/>
                  <TextBlock x:Name="RawInstallText" Style="{StaticResource Hint}" FontFamily="Cascadia Mono, Consolas"/>

                  <TextBlock Text="What PackPilot found in the file" Style="{StaticResource Label}" Margin="0,20,0,2"/>
                  <TextBlock x:Name="AnalyzerNotes" Style="{StaticResource Hint}" Margin="0"/>
                  <TextBlock x:Name="ArchText" Style="{StaticResource Hint}"/>
                  <TextBlock x:Name="SignatureText" Style="{StaticResource Hint}"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Detection">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="How Intune tells whether the app is installed." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                  <ComboBox x:Name="DetectionBox" SelectionChanged="OnDetectionChanged">
                    <ComboBoxItem Tag="MsiProductCode" Content="MSI product code (built-in Intune rule)"/>
                    <ComboBoxItem Tag="Registry" Content="Programs and Features entry (detection script)"/>
                    <ComboBoxItem Tag="File" Content="File exists (built-in Intune rule)"/>
                    <ComboBoxItem Tag="Marker" Content="Marker key written by Install.ps1 (for scripts)"/>
                  </ComboBox>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <StackPanel x:Name="NamePanel">
                        <TextBlock Text="Programs and Features name (* = wildcard)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="DisplayNameBox" Style="{StaticResource Mono}"/>
                      </StackPanel>
                      <StackPanel x:Name="FilePanel">
                        <TextBlock Text="File path (e.g. %ProgramFiles%\App\app.exe)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="DetectFileBox" Style="{StaticResource Mono}"/>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" x:Name="VersionPanel">
                      <TextBlock Text="Minimum version" Style="{StaticResource Label}"/>
                      <TextBox x:Name="MinVersionBox" Style="{StaticResource Mono}"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="DetectionSummaryText" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Uninstall">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="Uninstall.ps1 uses the first one filled in: a custom command, the MSI product code, or the Programs and Features name from Detection."/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Custom uninstall program or script" Style="{StaticResource Label}"/>
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="..." Click="OnBrowseUninstall" Margin="6,0,0,0" Padding="10,4"/>
                        <TextBox x:Name="UninstallFileBox" Style="{StaticResource Mono}"/>
                      </DockPanel>
                      <TextBlock Text="MSI product code" Style="{StaticResource Label}"/>
                      <TextBox x:Name="ProductCodeBox" Style="{StaticResource Mono}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Its arguments" Style="{StaticResource Label}"/>
                      <TextBox x:Name="UninstallArgsBox" Style="{StaticResource Mono}"/>
                      <TextBlock Text="Silent flags for the app's UninstallString" Style="{StaticResource Label}"/>
                      <TextBox x:Name="SilentArgsBox" Style="{StaticResource Mono}"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="UninstallSummary" Style="{StaticResource Hint}" Margin="0,12,0,0" FontFamily="Cascadia Mono, Consolas"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Options">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="Package" Style="{StaticResource Label}" Margin="0,0,0,0"/>
                  <CheckBox x:Name="IncludeFolderBox" Content="Include every file in the installer's folder" Margin="0,4,0,0"/>
                  <TextBlock x:Name="FolderStatsText" Style="{StaticResource Hint}"/>
                  <TextBlock Text="Output folder" Style="{StaticResource Label}" Margin="0,12,0,3"/>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="..." Click="OnBrowseOutput" Margin="6,0,0,0" Padding="10,4"/>
                    <TextBox x:Name="OutputBox"/>
                  </DockPanel>
                  <TextBlock Text="Sandbox test" Style="{StaticResource Label}" Margin="0,18,0,0"/>
                  <CheckBox x:Name="ReuseBox" Content="Reuse one Sandbox for every test (faster)" Click="OnReuseChanged" Margin="0,4,0,0"/>
                  <CheckBox x:Name="NoNetworkBox" Content="Test without network"/>
                  <CheckBox x:Name="SkipUninstallBox" Content="Skip the uninstall test"/>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Install time limit" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TimeoutBox" Width="48"/>
                    <TextBlock Text="minutes" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                  <TextBlock x:Name="OptionsSummary" Visibility="Collapsed"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Intune settings">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="For entering the app by hand in the Intune admin center. Upload to Intune fills these in for you." Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                  <TextBlock Text="Install command" Style="{StaticResource Label}"/>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource Link}" Click="OnCopy" Tag="install" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="InstallCmdBox" Style="{StaticResource Mono}" IsReadOnly="True" TextWrapping="Wrap"/>
                  </DockPanel>
                  <TextBlock Text="Uninstall command" Style="{StaticResource Label}"/>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource Link}" Click="OnCopy" Tag="uninstall" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="UninstallCmdBox" Style="{StaticResource Mono}" IsReadOnly="True" TextWrapping="Wrap"/>
                  </DockPanel>
                  <TextBlock Text="Detection" Style="{StaticResource Label}"/>
                  <TextBlock x:Name="DetectionCmdText" TextWrapping="Wrap" FontSize="12"/>
                  <TextBlock Text="Install behavior: System · Restart: based on return codes · Return codes: Intune defaults" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                  <Button Content="Copy all settings" Style="{StaticResource Link}" Click="OnCopy" Tag="all" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Border>

        <!-- Steps and result -->
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Button x:Name="BuildButton" Style="{StaticResource Primary}" Click="OnBuild" IsEnabled="False">
                <StackPanel><TextBlock Text="1   Build" Foreground="White" FontWeight="SemiBold"/><TextBlock x:Name="BuildSub" Text="Package, encrypt and verify" Foreground="#DBEAFE" FontSize="11"/></StackPanel>
              </Button>
              <Button x:Name="TestButton" Style="{StaticResource Primary}" Click="OnTest" IsEnabled="False">
                <StackPanel><TextBlock Text="2   Test in Sandbox" Foreground="White" FontWeight="SemiBold"/><TextBlock x:Name="TestSub" Text="Install, detect, uninstall as SYSTEM" Foreground="#DBEAFE" FontSize="11"/></StackPanel>
              </Button>
              <Button x:Name="UploadButton" Style="{StaticResource Primary}" Click="OnUpload" IsEnabled="False" Margin="0">
                <StackPanel><TextBlock Text="3   Upload to Intune" Foreground="White" FontWeight="SemiBold"/><TextBlock x:Name="UploadSub" Text="Commercial, GCC, GCC High, DoD" Foreground="#DBEAFE" FontSize="11"/></StackPanel>
              </Button>
              <Button x:Name="LearnButton" Style="{StaticResource Danger}" Click="OnApplyLearned" Visibility="Collapsed" Margin="0,8,0,0"/>
              <ProgressBar x:Name="Busy" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0"/>
              <DockPanel Margin="0,8,0,0">
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource Link}" Click="OnCancel" Visibility="Collapsed" Content="Stop waiting"/>
                <Button x:Name="CloseSandboxButton" DockPanel.Dock="Left" Style="{StaticResource Link}" Click="OnCloseSandbox" Visibility="Collapsed" Content="Close test Sandbox" HorizontalAlignment="Left"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0">
            <StackPanel>
              <DockPanel>
                <Border x:Name="VerdictChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="0">
                  <TextBlock x:Name="VerdictText" Text="Not tested" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="Status" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock x:Name="PackageStatus" Text="No package yet." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
              <ItemsControl x:Name="StepsList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,2">
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Mark}" Foreground="{Binding Color}" FontWeight="Bold" Width="18"/>
                      <TextBlock TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding Detail}"><Run Text="{Binding Step, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Short, Mode=OneWay}" Foreground="{StaticResource Muted}"/></TextBlock>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel Margin="0,12,0,0">
                <Button x:Name="OpenReportButton" Style="{StaticResource Link}" Click="OnOpenReport" IsEnabled="False" Content="Report" Margin="0,0,16,0"/>
                <Button x:Name="OpenGuideButton" Style="{StaticResource Link}" Click="OnOpenGuide" IsEnabled="False" Content="Deployment guide" Margin="0,0,16,0"/>
                <Button x:Name="OpenFolderButton" Style="{StaticResource Link}" Click="OnOpenFolder" IsEnabled="False" Content="Output folder"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Activity log, always visible -->
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Activity" FontWeight="SemiBold" Margin="2,0,0,4"/>
          <TextBox x:Name="LogBox" IsReadOnly="True" Style="{StaticResource Mono}" FontSize="11.5" BorderThickness="0" Padding="2"
                   VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" VerticalContentAlignment="Top" Background="{StaticResource Panel}"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
